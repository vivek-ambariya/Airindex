# Copy to .env and fill in. .env is gitignored; never commit real values.

# ---- Database ----------------------------------------------------------
# XAMPP's MariaDB listens on 3306 and ships with an EMPTY root password.
# It is declared here explicitly rather than left implicit.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aqi_india

# ---- OpenAQ ------------------------------------------------------------
# Free key from https://explore.openaq.org/register — sent as the X-API-Key
# header. collect.py exits with a clear message if this is unset.
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3

# Country to collect. ISO-3166 alpha-2. Phase 8 (Asia) changes THIS LINE
# ONLY — the collector has no India-specific logic anywhere.
COLLECT_COUNTRY=IN

# ---- Flask -------------------------------------------------------------
FLASK_ENV=development
FLASK_PORT=5000
# CORS: the Vite dev server, and nothing else.
CORS_ORIGIN=http://localhost:5173

# ---- Alerts ------------------------------------------------------------
# send_email() writes here instead of sending. One function, swap later.
EMAIL_LOG_PATH=../logs/emails.log
# Base URL used to build verify/unsubscribe links in those stubbed emails.
PUBLIC_APP_URL=http://localhost:5173
